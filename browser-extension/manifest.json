{
  "manifest_version": 3,
  "name": "Wishboard — Save Anything",
  "version": "1.0.0",
  "description": "Save a product or page to your Wishboard from almost any store.",
  "permissions": ["contextMenus", "activeTab", "scripting", "tabs"],
